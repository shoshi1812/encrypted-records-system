{
  "openapi": "3.0.3",
  "info": {
    "title": "Encrypted Records API",
    "version": "1.0.0",
    "description": "API של מערכת רשומות מוצפנות. התוכן נשלח ומוחזר כטקסט רגיל בשדה content; ההצפנה (AES-256-GCM) מתבצעת בשרת בלבד ואינה חלק מהחוזה.\n\nהדגמה: התחברי ב-POST /api/auth/login, העתיקי את accessToken, לחצי Authorize והדביקי אותו."
  },
  "servers": [
    {
      "url": "/",
      "description": "השרת הנוכחי"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Auth",
      "description": "הרשמה, התחברות ופרטי המשתמש"
    },
    {
      "name": "Cipher Records",
      "description": "רשומות. כללי הגישה: מסמך 02 סעיף 6"
    },
    {
      "name": "Admin",
      "description": "מנהל בלבד"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "errorCode",
          "message"
        ],
        "properties": {
          "errorCode": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "INVALID_CREDENTIALS",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "RECORD_NOT_FOUND",
              "RECIPIENT_NOT_FOUND",
              "ROUTE_NOT_FOUND",
              "EMAIL_ALREADY_EXISTS",
              "PAYLOAD_TOO_LARGE",
              "TOO_MANY_REQUESTS",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "description": "בשגיאת ולידציה בלבד",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "USER",
          "ADMIN"
        ]
      },
      "Category": {
        "type": "string",
        "enum": [
          "DOCUMENT",
          "NOTE",
          "CODE",
          "OTHER"
        ]
      },
      "Visibility": {
        "type": "string",
        "enum": [
          "PRIVATE",
          "PUBLIC"
        ]
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "description": "נשמר ב-lowercase"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "8 תווים לפחות, אות אחת ומספר אחד לפחות (בהרשמה)"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "user"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "description": "תוקף בשניות",
            "example": 3600
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "AdminUser": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CipherRecordListItem": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "category",
          "visibility",
          "createdAt",
          "senderEmail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 300,
            "description": "null כשאין תיאור"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "senderEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "CipherRecordDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CipherRecordListItem"
          },
          {
            "type": "object",
            "required": [
              "recipientEmail",
              "content"
            ],
            "properties": {
              "recipientEmail": {
                "type": "string",
                "format": "email",
                "nullable": true,
                "description": "null כשהפונה אינו השולח ואינו הנמען"
              },
              "content": {
                "type": "string",
                "nullable": true,
                "description": "התוכן המפוענח. null כשהפונה אינו השולח ואינו הנמען"
              }
            }
          }
        ]
      },
      "CipherRecordPage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CipherRecordListItem"
            }
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "totalCount": {
            "type": "integer"
          }
        }
      },
      "CreateCipherRecordRequest": {
        "type": "object",
        "required": [
          "title",
          "recipientEmail",
          "category",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "nullable": true
          },
          "recipientEmail": {
            "type": "string",
            "format": "email",
            "description": "אימייל של משתמש קיים. מותר גם האימייל של השולח עצמו"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "visibility": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Visibility"
              }
            ],
            "default": "PRIVATE"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "description": "טקסט רגיל. השרת מצפין אותו לפני השמירה. מעל 20,000 תווים: 400 VALIDATION_ERROR"
          }
        }
      },
      "UpdateCipherRecordRequest": {
        "type": "object",
        "required": [
          "title",
          "category",
          "visibility"
        ],
        "description": "רק חמשת השדות האלה ניתנים לשינוי. הבעלים והנמען אינם משתנים לעולם, גם אם נשלחו.",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "nullable": true,
            "description": "null או מחרוזת ריקה מנקים את התיאור. אם השדה לא נשלח, התיאור נשאר כפי שהוא"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "description": "אופציונלי. אם נשלח: השרת מצפין אותו מחדש והתוכן הקודם מוחלף. אם לא נשלח: התוכן הקיים נשאר כפי שהוא. מחרוזת ריקה אינה תקפה (400)"
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "בדיקת חיות השרת",
        "description": "הרשאות: פתוח.",
        "security": [],
        "responses": {
          "200": {
            "description": "השרת פעיל",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "example": {
                  "status": "ok",
                  "timestamp": "2026-10-26T12:00:00.000Z"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "הרשמה",
        "description": "הרשאות: פתוח. יוצר חשבון USER ומחזיר טוקן (התחברות אוטומטית). שדה אימות סיסמה אינו חלק מהחוזה.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              },
              "example": {
                "email": "dana@example.com",
                "password": "Example123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "החשבון נוצר",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "tokenType": "Bearer",
                  "expiresIn": 3600,
                  "user": {
                    "id": "3f1c2b9e-8a41-4f0e-9d3a-2c5b7e1a0f11",
                    "email": "dana@example.com",
                    "role": "USER"
                  }
                }
              }
            }
          },
          "400": {
            "description": "נתונים שאינם עומדים בסכמה (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "VALIDATION_ERROR",
                  "message": "הנתונים שנשלחו אינם תקינים.",
                  "details": [
                    {
                      "field": "title",
                      "message": "כותרת היא שדה חובה"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "האימייל כבר רשום",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "EMAIL_ALREADY_EXISTS",
                  "message": "כתובת האימייל כבר רשומה במערכת."
                }
              }
            }
          },
          "429": {
            "description": "יותר מדי ניסיונות",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "TOO_MANY_REQUESTS",
                  "message": "יותר מדי ניסיונות. נסי שוב בעוד מספר דקות."
                }
              }
            }
          },
          "500": {
            "description": "שגיאה לא צפויה, כולל כשל פענוח (INTERNAL_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "INTERNAL_ERROR",
                  "message": "אירעה שגיאה פנימית בשרת."
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "התחברות",
        "description": "הרשאות: פתוח. מחזיר JWT לשעה. אותה הודעה בדיוק לאימייל שאינו קיים ולסיסמה שגויה.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              },
              "example": {
                "email": "dana@example.com",
                "password": "Example123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "התחברות הצליחה",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "example": {
                  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "tokenType": "Bearer",
                  "expiresIn": 3600,
                  "user": {
                    "id": "3f1c2b9e-8a41-4f0e-9d3a-2c5b7e1a0f11",
                    "email": "dana@example.com",
                    "role": "USER"
                  }
                }
              }
            }
          },
          "400": {
            "description": "נתונים שאינם עומדים בסכמה (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "VALIDATION_ERROR",
                  "message": "הנתונים שנשלחו אינם תקינים.",
                  "details": [
                    {
                      "field": "title",
                      "message": "כותרת היא שדה חובה"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "אימייל או סיסמה שגויים",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "INVALID_CREDENTIALS",
                  "message": "אימייל או סיסמה שגויים."
                }
              }
            }
          },
          "429": {
            "description": "יותר מדי ניסיונות התחברות",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "TOO_MANY_REQUESTS",
                  "message": "יותר מדי ניסיונות. נסי שוב בעוד מספר דקות."
                }
              }
            }
          },
          "500": {
            "description": "שגיאה לא צפויה, כולל כשל פענוח (INTERNAL_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "INTERNAL_ERROR",
                  "message": "אירעה שגיאה פנימית בשרת."
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "פרטי המשתמש המחובר",
        "description": "הרשאות: מחובר. משמש את הקליינט לשחזור התחברות אחרי רענון.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "המשתמש לפי הטוקן",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "example": {
                  "id": "3f1c2b9e-8a41-4f0e-9d3a-2c5b7e1a0f11",
                  "email": "dana@example.com",
                  "role": "USER"
                }
              }
            }
          },
          "401": {
            "description": "טוקן חסר, פגום או שפג תוקפו (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "UNAUTHORIZED",
                  "message": "נדרשת התחברות."
                }
              }
            }
          },
          "500": {
            "description": "שגיאה לא צפויה, כולל כשל פענוח (INTERNAL_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "INTERNAL_ERROR",
                  "message": "אירעה שגיאה פנימית בשרת."
                }
              }
            }
          }
        }
      }
    },
    "/api/cipher-records": {
      "get": {
        "tags": [
          "Cipher Records"
        ],
        "summary": "רשימת רשומות",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "הרשאות: מחובר. USER רואה את רשומותיו, רשומות שנשלחו אליו וכל הרשומות הציבוריות. ADMIN רואה את כל הרשומות. הרשימה אינה כוללת תוכן ואימייל נמען. החיפוש פועל על הכותרת בלבד, כי התוכן מוצפן במסד.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "חיפוש חלקי בכותרת, לא תלוי רישיות",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Category"
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "required": false,
            "description": "מיון לפי תאריך יצירה",
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ],
              "default": "DESC"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "מקסימום 100. ערך גדול יותר נדחה ב-400",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "עמוד תוצאות",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CipherRecordPage"
                },
                "example": {
                  "items": [
                    {
                      "id": "b8e2d6a4-1c3f-4e5a-9b7d-0f2e4c6a8b10",
                      "title": "חוזה שכירות",
                      "description": "טיוטה ראשונה לבדיקה",
                      "category": "DOCUMENT",
                      "visibility": "PRIVATE",
                      "createdAt": "2026-10-26T10:00:00.000Z",
                      "senderEmail": "dana@example.com"
                    }
                  ],
                  "page": 1,
                  "pageSize": 20,
                  "totalCount": 1
                }
              }
            }
          },
          "400": {
            "description": "נתונים שאינם עומדים בסכמה (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "VALIDATION_ERROR",
                  "message": "הנתונים שנשלחו אינם תקינים.",
                  "details": [
                    {
                      "field": "title",
                      "message": "כותרת היא שדה חובה"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "טוקן חסר, פגום או שפג תוקפו (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "UNAUTHORIZED",
                  "message": "נדרשת התחברות."
                }
              }
            }
          },
          "500": {
            "description": "שגיאה לא צפויה, כולל כשל פענוח (INTERNAL_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "errorCode": "INTERNAL_ERROR",
                  "message": "אירעה שגיאה פנימית בשרת."
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Cipher Records"
        ],
