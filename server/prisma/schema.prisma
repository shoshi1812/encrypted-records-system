generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // אם ספק המסד מחייב pooler, יש להוסיף כאן: directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Category {
  DOCUMENT
  NOTE
  CODE
  OTHER
}

enum Visibility {
  PRIVATE
  PUBLIC
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(255)
  passwordHash    String
  role            Role           @default(USER)
  createdAt       DateTime       @default(now()) @db.Timestamptz
  ownedRecords    CipherRecord[] @relation("Owner")
  receivedRecords CipherRecord[] @relation("Recipient")

  @@map("users")
}

model CipherRecord {
  id               String     @id @default(uuid()) @db.Uuid
  title            String     @db.VarChar(150)
  description      String?    @db.VarChar(300)
  ownerId          String     @db.Uuid
  recipientId      String     @db.Uuid
  category         Category
  visibility       Visibility @default(PRIVATE)
  encryptedContent String
  nonce            String
  createdAt        DateTime   @default(now()) @db.Timestamptz
  owner            User       @relation("Owner", fields: [ownerId], references: [id], onDelete: Restrict)
  recipient        User       @relation("Recipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([recipientId])
  @@index([createdAt])
  @@map("cipher_records")
}
